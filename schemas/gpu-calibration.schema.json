{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://north-standard.dev/schemas/gpu-calibration/0.1",
  "title": "North Standard GPU Calibration v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "provenance",
    "calibration_id",
    "created_at_unix_ms",
    "device_fingerprint",
    "device",
    "runtime_profile_id",
    "benchmark_profile_id",
    "reference_compute_gflops",
    "reference_memory_gbps",
    "trace_count",
    "sample_count",
    "source_capture_ids",
    "status",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "gpu-calibration/0.1"},
    "provenance": {"const": "RECORDED_REAL"},
    "calibration_id": {"type": "string", "minLength": 1},
    "created_at_unix_ms": {"type": "integer", "minimum": 0},
    "device_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "device": {"type": "object"},
    "runtime_profile_id": {"type": "string", "minLength": 1},
    "benchmark_profile_id": {"type": "string", "minLength": 1},
    "challenge_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "challenge_profile": {
      "type": "object",
      "required": ["elements", "compute_inner_iterations", "warmup_iterations"],
      "properties": {
        "elements": {"type": "integer", "minimum": 1},
        "compute_inner_iterations": {"type": "integer", "minimum": 1},
        "warmup_iterations": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "reference_compute_gflops": {"type": "number", "exclusiveMinimum": 0},
    "reference_memory_gbps": {"type": "number", "exclusiveMinimum": 0},
    "trace_count": {"type": "integer", "minimum": 1},
    "sample_count": {"type": "integer", "minimum": 2},
    "source_capture_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "status": {"const": "RESEARCH_CALIBRATION_NOT_PRODUCTION_THRESHOLD"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
