{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://north-standard.dev/schemas/gpu-trace/0.1",
  "title": "North Standard Recorded GPU Trace v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "provenance",
    "capture_id",
    "captured_at_unix_ms",
    "contract_id",
    "session_id",
    "runtime_profile_id",
    "benchmark_profile_id",
    "collector",
    "device",
    "challenge",
    "samples",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "gpu-trace/0.1"},
    "provenance": {"const": "RECORDED_REAL"},
    "capture_id": {"type": "string", "minLength": 1},
    "captured_at_unix_ms": {"type": "integer", "minimum": 0},
    "contract_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "runtime_profile_id": {"type": "string", "minLength": 1},
    "benchmark_profile_id": {"type": "string", "minLength": 1},
    "collector": {
      "type": "object",
      "required": ["name", "version", "authentication"],
      "properties": {
        "name": {"const": "north-standard-cuda-probe"},
        "version": {"type": "string", "minLength": 1},
        "authentication": {"const": "LOCAL_SOFTWARE_ONLY"}
      },
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "required": [
        "ordinal",
        "name",
        "compute_capability_major",
        "compute_capability_minor",
        "global_memory_bytes",
        "multiprocessor_count",
        "max_clock_khz",
        "memory_clock_khz",
        "memory_bus_width_bits",
        "cuda_runtime_version",
        "cuda_driver_version"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1},
        "compute_capability_major": {"type": "integer", "minimum": 1},
        "compute_capability_minor": {"type": "integer", "minimum": 0},
        "global_memory_bytes": {"type": "integer", "minimum": 1},
        "multiprocessor_count": {"type": "integer", "minimum": 1},
        "max_clock_khz": {"type": "integer", "minimum": 1},
        "memory_clock_khz": {"type": "integer", "minimum": 1},
        "memory_bus_width_bits": {"type": "integer", "minimum": 1},
        "cuda_runtime_version": {"type": "integer", "minimum": 1},
        "cuda_driver_version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "challenge": {
      "type": "object",
      "required": [
        "elements",
        "compute_inner_iterations",
        "warmup_iterations",
        "measurement_iterations"
      ],
      "properties": {
        "elements": {"type": "integer", "minimum": 1},
        "compute_inner_iterations": {"type": "integer", "minimum": 1},
        "warmup_iterations": {"type": "integer", "minimum": 0},
        "measurement_iterations": {"type": "integer", "minimum": 2}
      },
      "additionalProperties": false
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "sample_index",
          "observed_at_unix_ms",
          "compute_ms",
          "compute_gflops",
          "memory_ms",
          "memory_gbps"
        ],
        "properties": {
          "sample_index": {"type": "integer", "minimum": 0},
          "observed_at_unix_ms": {"type": "integer", "minimum": 0},
          "compute_ms": {"type": "number", "exclusiveMinimum": 0},
          "compute_gflops": {"type": "number", "exclusiveMinimum": 0},
          "memory_ms": {"type": "number", "exclusiveMinimum": 0},
          "memory_gbps": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
